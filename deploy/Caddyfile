# Single entry point: HTTPS, the built frontend, the API, and video files with range requests.
# The same file serves Docker Compose and Apptainer; the differences are environment variables:
#
# SITE_ADDRESSES the names Caddy serves, comma separated (default localhost). The Apptainer
#                launcher passes the configured hostname plus localhost and 127.0.0.1 so the
#                app also answers through an SSH tunnel (ssh -L 8443:127.0.0.1:8443)
# HTTP_PORT, HTTPS_PORT   80 and 443 by default; rootless Apptainer uses 8080 and 8443
# API_UPSTREAM   api:8000 on the Compose network; 127.0.0.1:8000 on the Apptainer host network
# MEDIA_ROOT     where the storage volume is mounted read-only (default /srv/media)
# /etc/caddy/tls.caddy   `tls internal` for development, or `tls <cert> <key>` in production
{
	admin off
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
	# Caddy's own redirect assumes clients reach HTTPS on 443 (https_port is documented as
	# internal only), so with rootless ports it would send browsers to https://host/ and
	# lose :8443. The redirect below includes the real port.
	auto_https disable_redirects
	# Caddy would otherwise try to add its local CA to the system trust store at every start,
	# which fails without root and only produces an error line in the log.
	skip_install_trust
}

http:// {
	redir https://{http.request.host}:{$HTTPS_PORT:443}{http.request.uri} permanent
}

{$SITE_ADDRESSES:localhost} {
	import /etc/caddy/tls.caddy
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy same-origin
	}

	# API (and tus uploads). Bodies stream straight through; no size limit for match files.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000} {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# Video, posters and thumbnails: ask the API whether this user may see this file, then let
	# Caddy serve it from the storage volume with HTTP range requests.
	handle /media/* {
		forward_auth {$API_UPSTREAM:api:8000} {
			uri /api/media/authorize
		}
		uri strip_prefix /media
		root * {$MEDIA_ROOT:/srv/media}
		header Cache-Control "private, max-age=3600"
		file_server
	}

	# The React app. Unknown paths fall back to index.html for client-side routing.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
