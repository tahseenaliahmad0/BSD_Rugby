# Reference copy of the user-level systemd unit. Prefer `deploy/apptainer/rugby.sh
# install-service`, which writes this file with the real path of your checkout, then
#   loginctl enable-linger $USER      # keeps user services running when nobody is logged in
[Unit]
Description=Rugby video analysis (Apptainer instances)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/Desktop/bsd/deploy/apptainer/rugby.sh start
ExecStop=%h/Desktop/bsd/deploy/apptainer/rugby.sh stop
TimeoutStartSec=600

[Install]
WantedBy=default.target
