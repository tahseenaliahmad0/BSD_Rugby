# Caddy with the built frontend, for Apptainer. Three stages: build the frontend with Node,
# take the Caddy binary from the official image, and assemble a small Debian image with
# both. Mirrors deploy/caddy/Dockerfile.
#
# Why not run the official caddy:2-alpine image directly, as the Dockerfile does?
# 1. The official image gives /usr/bin/caddy the file capability cap_net_bind_service (so it
#    can bind 80/443 as non-root under Docker). In a rootless Apptainer run the kernel cannot
#    map that capability's owner into the user namespace and refuses to execute the file at
#    all: "caddy: Value too large for data type" (EOVERFLOW). We listen on 8080/8443 and do
#    not need the capability, so the binary is re-copied here, which drops the attribute.
# 2. Apptainer's fakeroot helper is a glibc binary and cannot run inside an Alpine (musl)
#    image, so a %post section there fails with "exec /.singularity.d/libs/fakeroot failed".
#    Debian stages have no such problem (the backend image builds the same way).
Bootstrap: docker
From: node:22-bookworm-slim
Stage: build

%files
    build/frontend /src

%post
    set -e
    cd /src
    npm ci --no-audit --no-fund
    npx vite build

Bootstrap: docker
From: caddy:2-alpine
Stage: caddy

Bootstrap: docker
From: debian:bookworm-slim
Stage: final

%files from caddy
    /usr/bin/caddy /opt/caddy-from-image

# Apptainer copies a directory INTO an existing destination (/src/dist -> /srv/dist), unlike
# Docker's COPY which merges its contents. So stage the build somewhere new and move the
# contents into /srv in %post, where `test` makes the build fail if the layout is wrong.
%files from build
    /src/dist /opt/frontend

%files
    ../Caddyfile /etc/caddy/Caddyfile
    ../caddy/tls.dev.caddy /etc/caddy/tls.caddy

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates mailcap
    rm -rf /var/lib/apt/lists/*
    # A plain copy writes a new file without the source's extended attributes, so the
    # cap_net_bind_service capability from the official image does not come along.
    cp /opt/caddy-from-image /usr/bin/caddy
    rm -f /opt/caddy-from-image
    chmod 0755 /usr/bin/caddy
    mkdir -p /config /data /srv /etc/caddy
    cp -a /opt/frontend/. /srv/
    rm -rf /opt/frontend
    test -f /srv/index.html
    /usr/bin/caddy version

%environment
    export XDG_CONFIG_HOME=/config
    export XDG_DATA_HOME=/data

%startscript
    exec /usr/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile

%runscript
    exec /usr/bin/caddy "$@"

%help
    Set SITE_ADDRESS, HTTP_PORT, HTTPS_PORT, API_UPSTREAM and MEDIA_ROOT. Bind the storage
    volume read-only at /srv/media, a writable directory at /data (certificates) and another at
    /config. Bind a TLS snippet over /etc/caddy/tls.caddy for production certificates.
