# Settings for deploy/apptainer/rugby.sh. Copy to deploy/apptainer/rugby.env and edit.
# Everything the launcher starts listens on this host only, except Caddy.

# Where all data lives: postgres/, media/ (originals, proxies, exports), caddy/, logs/.
# Must be a folder you own. Footage is large, so point this at your biggest writable disk.
DATA_DIR=$HOME/rugby-data

# The hostname coaches type. Caddy serves https://SITE_ADDRESS:HTTPS_PORT.
SITE_ADDRESS=localhost
# A rootless process cannot bind 80/443. Keep 8080/8443, or ask IT to run
#   sudo sysctl net.ipv4.ip_unprivileged_port_start=0   (then set 80 and 443 here).
HTTP_PORT=8080
HTTPS_PORT=8443

# TLS: deploy/apptainer/tls.caddy is used if it exists (see tls.caddy.example), otherwise
# Caddy's internal certificate authority. CERTS_DIR is bound read-only at /certs.
CERTS_DIR=

# Internal ports on 127.0.0.1. Change them if something else on the server uses them.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

POSTGRES_USER=rugby
POSTGRES_PASSWORD=choose-a-long-random-password
POSTGRES_DB=rugby

# First administrator, used by `rugby.sh create-admin` and `rugby.sh seed`.
ADMIN_EMAIL=analyst@college.edu
ADMIN_NAME=Head Analyst
ADMIN_PASSWORD=choose-another-long-password

# auto uses NVENC when the GPU is reachable (needs the NVIDIA driver on the host).
TRANSCODE_ENCODER=auto
# auto: pass --nv to the workers when nvidia-smi is present. Set to no to force CPU only.
GPU=auto
# Parallel transcodes on the cpu worker.
WORKER_CONCURRENCY=1
